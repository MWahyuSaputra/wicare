set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY wicare_avalon
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VERILOG_FILE ../../rtl/wicare_avalon.v
set_global_assignment -name VERILOG_FILE ../../rtl/wicare_pipe.v
set_global_assignment -name VERILOG_FILE ../../rtl/ascon_tag.v
set_global_assignment -name VERILOG_FILE ../../rtl/key_prov.v
set_global_assignment -name VERILOG_FILE ../../rtl/uart_rx.v
set_global_assignment -name VERILOG_FILE ../../rtl/csi_frame_rx.v
set_global_assignment -name SDC_FILE wicare_resource.sdc

set_location_assignment PIN_V11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to avs_s0_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to avs_s0_read
set_instance_assignment -name VIRTUAL_PIN ON -to avs_s0_readdata[*]
set_instance_assignment -name VIRTUAL_PIN ON -to avs_s0_write
set_instance_assignment -name VIRTUAL_PIN ON -to avs_s0_writedata[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ins_irq0_irq
set_instance_assignment -name VIRTUAL_PIN ON -to coe_csi_rx
set_instance_assignment -name VIRTUAL_PIN ON -to coe_prov_rx
set_instance_assignment -name VIRTUAL_PIN ON -to coe_led[*]
